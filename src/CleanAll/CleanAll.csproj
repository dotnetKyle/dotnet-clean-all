<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
		
	<PackAsTool>true</PackAsTool>
	<Authors>dotnetKyle</Authors>
	<Description>A package that removes all bin and obj files that sometimes a 3rd party tool leaves behind after a dotnet clean is ran.</Description>
	<PackageTags>dotnet, clean</PackageTags>
	<PackageProjectUrl>https://github.com/dotnetKyle/dotnet-clean-all</PackageProjectUrl>
	<RepositoryUrl>https://github.com/dotnetKyle/dotnet-clean-all</RepositoryUrl>
	<PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>
        $([System.IO.File]::ReadAllText("$(MSBuildProjectDirectory)/RELEASENOTES.md"))
    </PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.SolutionPersistence" Version="1.0.52" />
    <PackageReference Include="ShellRunner" Version="0.2.10-alpha" />
    <PackageReference Include="MinimalCli" Version="3.0.0" />
  </ItemGroup>

	<ItemGroup>
		<None Include="..\..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

</Project>
